# set-token.sh bu dosyayı .env olarak kopyalar ve tokenı gizli girişle ekler.
# Tokenı buraya elle yazma; .env git'e girmez.
FLUXER_BOT_TOKEN=
FLUXER_INSTANCE=https://pirichat.online

